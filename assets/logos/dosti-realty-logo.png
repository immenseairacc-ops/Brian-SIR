    <!-- Enquiry dialog -->
    <dialog id="enquiry" class="dialog" aria-labelledby="enquiry-title">
        <div class="dialog__card">
            <button class="dialog__close" type="button" data-close aria-label="Close"><svg aria-hidden="true">
                    <use href="#i-close" />
                </svg></button>
            <h2 class="dialog__title" id="enquiry-title">Enquire Now</h2>
            <p class="dialog__sub" id="enquiry-sub">Please enter your details to know more</p>
            <form id="main-form" class="form" action="thank-you.php" method="POST" data-lead novalidate>
                <input type="hidden" id="enquiry-source" name="source" value="Enquire Now">
                <input type="hidden" id="enquiry-project" name="dtlproject" value="">
                <div class="field">
                    <label class="visually-hidden" for="eq-name">Name</label>
                    <input class="input" id="eq-name" type="text" name="fname" placeholder="Name*" autocomplete="name"
                        required pattern="[A-Za-z][A-Za-z ]*" maxlength="100">
                    <span class="field__error">Please enter your name (letters only)</span>
                </div>
                <div class="field">
                    <div class="field__row">
                        <input class="input input--cc" type="text" value="+91" name="cc" readonly
                            aria-label="Country code">
                        <div>
                            <label class="visually-hidden" for="eq-mobile">Mobile number</label>
                            <input class="input" id="eq-mobile" type="tel" name="mobile" placeholder="Mobile*"
                                inputmode="numeric" autocomplete="tel-national" required pattern="[6-9][0-9]{9}"
                                maxlength="10">
                        </div>
                    </div>
                    <span class="field__error">Enter a valid 10-digit mobile number</span>
                </div>
                <div class="field">
                    <label class="visually-hidden" for="eq-email">Email</label>
                    <input class="input" id="eq-email" type="email" name="email" placeholder="Email"
                        autocomplete="email">
                    <span class="field__error">Please enter a valid email address</span>
                </div>
                <label class="consent">
                    <input type="checkbox" name="whatsappin" value="Check" checked>
                    <span>I authorise Dosti Realty &amp; its representatives to contact me with updates and
                        notifications via Email/SMS/WhatsApp/Call. This will override DND/NDNC.</span>
                </label>
                <button class="btn btn--gold btn--block" type="submit">Submit <svg aria-hidden="true">
                        <use href="#i-right" />
                    </svg></button>
            </form>
        </div>
    </dialog>

