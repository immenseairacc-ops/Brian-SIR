    <!-- Tracking (GTM x2 + Taboola): loaded on first interaction, or TP_DELAY ms after the page has loaded,
         so they no longer compete with the hero image / main thread during load.
         Set TP_DELAY to 0 to load them immediately again. -->
    <script>
        window.dataLayer = window.dataLayer || [];
        window._tfa = window._tfa || [];
        window._tfa.push({ notify: 'event', name: 'page_view', id: 1848618 });
        (function () {
            var TP_DELAY = 4000, started = false;
            function addScript(src, id) {
                var j = document.createElement('script');
                j.async = true; j.src = src; if (id) j.id = id;
                document.head.appendChild(j);
            }
            function loadTracking() {
                if (started) return; started = true;
                ['scroll', 'touchstart', 'pointerdown', 'keydown', 'mousemove'].forEach(function (ev) {
                    window.removeEventListener(ev, loadTracking);
                });
                ['GTM-WKMH9Q9K', 'GTM-P37XPCQ'].forEach(function (id) {
                    window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                    addScript('https://www.googletagmanager.com/gtm.js?id=' + id);
                });
                addScript('//cdn.taboola.com/libtrc/unip/1848618/tfa.js', 'tb_tfa_script');
            }
            ['scroll', 'touchstart', 'pointerdown', 'keydown', 'mousemove'].forEach(function (ev) {
                window.addEventListener(ev, loadTracking, { passive: true, once: true });
            });
            function afterLoad() { setTimeout(loadTracking, TP_DELAY); }
            if (document.readyState === 'complete') afterLoad(); else window.addEventListener('load', afterLoad);
        })();
    </script>
