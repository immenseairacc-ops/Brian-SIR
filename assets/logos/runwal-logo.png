<!-- ================Automatic submit Js====================== -->

<script>
function send_otp(elm) {
    var input_name = '#' + elm + ' input[name="fname"]';
    var input_emailid = '#' + elm + ' input[name="email"]';
    var input_mobileno = '#' + elm + ' input[name="mobile"]';
    var input_source = '#' + elm + ' input[name="source"]';
    var input_checkbox = '#' + elm + ' input[name="myCheckbox"]'; // Checkbox selector
    var hidden_checkbox = '#' + elm + ' input[name="myCheckboxHidden"]'; // Hidden input selector

    var name = jQuery(input_name).val();
    var emailid = jQuery(input_emailid).val();
    var mobileno = jQuery(input_mobileno).val();
    var source = jQuery(input_source).val();

    var mobileDigit = document.getElementById(elm + '-mobdigits');
    mobileDigit.innerHTML = 10 - mobileno.length + " digit(s) remaining";

    mobileno = mobileno.replace(/[^0-9]/g, '');
    if (mobileno.length != 10) {
        return false;
    }

    if (mobileno.length == 10) {
        mobileDigit.innerHTML = '';
        jQuery(input_mobileno).prop('readonly', true);

        setTimeout(function() {
            jQuery(input_mobileno).prop('readonly', false);
        }, 3000);

        if (name == "") {
            return false;
        }

        var atpos = emailid.indexOf("@");
        var dotpos = emailid.lastIndexOf(".");
        if (atpos < 1 || dotpos < atpos + 2 || dotpos + 2 >= emailid.length) {
            return false;
        }

        if (name != "" && mobileno != "" && emailid != "") {
            // ✅ Handle checkbox value before form submission:
            var checkboxElement = document.querySelector(input_checkbox);
            var hiddenElement = document.querySelector(hidden_checkbox);

            if (checkboxElement.checked) {
                // If checked, disable hidden input and set checkbox value = "true"
                hiddenElement.disabled = true;
                checkboxElement.value = "true";
            } else {
                // If unchecked, disable checkbox and allow hidden input to send "false"
                checkboxElement.disabled = true;
            }

            setTimeout(function() {
                $("#pageloader").fadeIn();
                $('#' + elm).submit();
                return true;
            }, 2000);

            if (elm == 'dwnld-form') {
                document.getElementById('broucher1').click();
            }
        } else {
            return false;
        }
    }
}
</script>


