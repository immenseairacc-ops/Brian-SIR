        <!-- ============ OVERVIEW ============ -->
        <div>
            <section class="section section--ivory" id="about">
                <div class="container overview">
                    <div class="reveal">
                        <img class="overview__logo" src="assets/img/logo-dwc.webp" alt="Dosti West County" width="720"
                            height="174" loading="lazy">
                        <h2 class="overview__title">Unleash your dream lifestyle amidst unmatched amenities at Dosti
                            West County</h2>
                        <p class="overview__text">Dosti West County is modern county living at its best: the convenience
                            of a mini city with the serenity of lush green open spaces, complete with a school, retail,
                            outdoor amenities and a clubhouse.</p>
                        <p class="overview__text">Already home to over 1,400 families in Dosti Oak and Dosti Cedar, it
                            will welcome a further 2,700 to 3,050+ residents in Dosti Pine, Dosti Maple, Dosti Olive,
                            Dosti Tulip and Dosti Nest.</p>
                        <ul class="tags" aria-label="Township highlights">
                            <li>Lifestyle</li>
                            <li>Education</li>
                            <li>Sport</li>
                            <li>Culture</li>
                            <li>Spirituality</li>
                            <li>Recreation</li>
                            <li>Healthcare</li>
                            <li>Infra &amp; Connectivity</li>
                        </ul>
                    </div>

                    <div class="form-card reveal">
                        <h2 class="form-card__title">2 &amp; 3 BHK Homes at Balkum, Thane</h2>
                        <p class="form-card__sub">Share your details and our team will get in touch</p>
                        <form id="overview-form" class="form" action="thank-you.php" method="POST" data-lead novalidate>
                            <input type="hidden" name="source" value="Price Popup">
                            <input type="hidden" name="enqproject" value="">
                            <div class="field">
                                <label class="visually-hidden" for="ov-name">Name</label>
                                <input class="input" id="ov-name" type="text" name="fname" placeholder="Name*"
                                    autocomplete="name" required pattern="[A-Za-z][A-Za-z ]*" maxlength="100">
                                <span class="field__error">Please enter your name (letters only)</span>
                            </div>
                            <div class="field">
                                <div class="field__row">
                                    <input class="input input--cc" type="text" value="+91" name="cc" readonly
                                        aria-label="Country code">
                                    <div>
                                        <label class="visually-hidden" for="ov-mobile">Mobile number</label>
                                        <input class="input" id="ov-mobile" type="tel" name="mobile"
                                            placeholder="Mobile*" inputmode="numeric" autocomplete="tel-national"
                                            required pattern="[6-9][0-9]{9}" maxlength="10">
                                    </div>
                                </div>
                                <span class="field__error">Enter a valid 10-digit mobile number</span>
                            </div>
                            <div class="field">
                                <label class="visually-hidden" for="ov-email">Email</label>
                                <input class="input" id="ov-email" type="email" name="email" placeholder="Email"
                                    autocomplete="email">
                                <span class="field__error">Please enter a valid email address</span>
                            </div>
                            <label class="consent">
                                <input type="checkbox" name="whatsappin" value="Check" checked>
                                <span>I authorise Dosti Realty &amp; its representatives to contact me with updates and
                                    notifications via Email/SMS/WhatsApp/Call. This will override DND/NDNC.</span>
                            </label>
                            <button class="btn btn--olive btn--block" type="submit">Submit <svg aria-hidden="true">
                                    <use href="#i-right" />
                                </svg></button>
                        </form>
                    </div>
                </div>
            </section>
        </div>

